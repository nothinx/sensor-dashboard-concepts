# Salin ke .env. Kode yang sama dipakai untuk emulator dan AWS; bedanya hanya di variabel ini.

# ===== EMULATOR (bawaan, untuk docker compose) =====
DYNAMODB_ENDPOINT=http://dynamodb:8000
AWS_REGION=ap-southeast-3
TABLE_NAME=GensetUps
# DynamoDB Local menerima kredensial apa saja; ini BUKAN kunci AWS asli
AWS_ACCESS_KEY_ID=lokal
AWS_SECRET_ACCESS_KEY=lokal
TICK_DETIK=10

# ===== CLOUD (akun AWS milik klien; lihat docs/CLOUD.md) =====
# Di Lambda: kosongkan DYNAMODB_ENDPOINT dan JANGAN isi kunci akses; kredensial berasal dari peran IAM fungsi.
# DYNAMODB_ENDPOINT=
# AWS_REGION=
# TABLE_NAME=
