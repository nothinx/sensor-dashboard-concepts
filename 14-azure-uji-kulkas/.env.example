# Salin ke .env. Pilih SATU set: EMULATOR (bawaan) atau CLOUD.

# --- EMULATOR (bawaan, lokal, tanpa biaya) ---
COSMOS_MODE=emulator
COSMOS_ENDPOINT=http://cosmos:8081
# Kunci publik bawaan Azure Cosmos DB Emulator (sama untuk semua pemasangan, bukan rahasia).
