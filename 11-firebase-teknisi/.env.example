# Salin ke .env. Kode yang sama dipakai untuk emulator dan Firebase asli; bedanya hanya di variabel ini.

# ===== EMULATOR (bawaan, untuk docker compose) =====
FIREBASE_EMULATOR=1
# ID proyek berawalan "demo-" membuat emulator berjalan tanpa akun Google dan tanpa akses jaringan ke Firebase
FIREBASE_PROJECT_ID=demo-konsep
FIREBASE_API_KEY=demo-api-key
# Sandi dua akun teknisi demo di Auth emulator (min. 8 karakter). Hanya untuk emulator lokal.
DEMO_SANDI=
TICK_DETIK=15

# ===== CLOUD (proyek Firebase milik klien; lihat docs/CLOUD.md) =====
# FIREBASE_EMULATOR=0
# FIREBASE_PROJECT_ID=
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_APP_ID=
