# Salin menjadi .env bila ingin mengubah nilai bawaan.
PORT_DASBOR=18040
# Interval pengukuran RMS oleh simulator (menit); spektrum ditulis tiap jam
UKUR_MENIT=10
# Panjang riwayat yang ditulis saat start (hari)
RIWAYAT_HARI=30
# Mesin dianggap offline bila pengukuran terakhir lebih tua dari ini (menit)
OFFLINE_MENIT=30
# 1 = GraphiQL aktif di GET /graphql (matikan di produksi)
GRAPHIQL=1
