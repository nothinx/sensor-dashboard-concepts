# Salin ke .env lalu ganti kata sandi dan token. Jangan commit .env.
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=ganti-kata-sandi-ini
INFLUX_ORG=konsep
INFLUX_BUCKET=oven_raw
# Token admin hanya untuk lingkungan uji. Produksi: token baca untuk API, token tulis untuk gateway.
INFLUX_TOKEN=ganti-token-panjang-acak-ini
TZ_OFFSET_MIN=420
# Toleransi selisih aktual dan setpoint per zona (°C)
ZONE_TOLERANCE_C=3
RECIPE_L1=[REAL DATA: nama resep Line 1]
RECIPE_L2=[REAL DATA: nama resep Line 2]
