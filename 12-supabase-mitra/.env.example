# Salin ke .env. File .env tidak boleh di-commit.
# Target peramban dipilih di web/config.js; target simulator lewat SIM_DB_URL.

# --- EMULATOR (Supabase CLI lokal, default) ---
# Nilai bawaan Supabase CLI; hanya berlaku di mesin lokal.
SIM_DB_URL=postgresql://postgres:postgres@host.docker.internal:18122/postgres
TICK_DETIK=45

# --- CLOUD (proyek Supabase milik klien) --- kosong sampai proyek dibuat; lihat docs/CLOUD.md
# Simulator TIDAK dijalankan di proyek produksi. URL dan anon key untuk peramban diisi di web/config.js.
SUPABASE_URL_CLOUD=
SUPABASE_ANON_KEY_CLOUD=
SUPABASE_DB_URL_CLOUD=
