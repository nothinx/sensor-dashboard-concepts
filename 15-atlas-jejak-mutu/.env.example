# Salin ke .env lalu ganti sandi. File .env tidak boleh di-commit.
# Pilih target: emulator (Atlas lokal di Docker, default) atau cloud (klaster MongoDB Atlas milik klien).
TARGET=emulator

# --- EMULATOR (mongodb-atlas-local) ---
MONGO_USER=jejak_admin
MONGO_PASSWORD=ganti-sandi-lokal

# --- CLOUD (MongoDB Atlas) --- kosong sampai klien membuat klaster; lihat docs/CLOUD.md
# Contoh bentuk: mongodb+srv://<user>:<sandi>@<klaster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI_CLOUD=

# Simulator: jeda antar langkah lini (detik)
TICK_DETIK=6
