# Salin ke .env lalu ganti nilainya. Jangan commit .env.
DB_USER=ipal_app
DB_PASSWORD=ganti-dengan-sandi-kuat
DB_ROOT_PASSWORD=ganti-dengan-sandi-root-kuat
# Kunci untuk header X-API-Key (minimal 32 karakter acak, mis. hasil: openssl rand -hex 24)
API_KEY=ganti-dengan-kunci-acak
# Rahasia HMAC tanda tangan webhook, disepakati dengan penerima
WEBHOOK_SECRET=ganti-dengan-rahasia-acak
# Interval simulator (detik)
TICK_DETIK=30
WEBHOOK_DETIK=60
