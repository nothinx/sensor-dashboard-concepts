# Diproses envsubst oleh image nginx: hanya ${API_KEY} yang diganti.
server {
  listen 80;
  root /srv/web;
  index index.html;

  # Dasbor hanya boleh membaca. Kunci API disisipkan di sini supaya tidak pernah sampai ke peramban.
  location /api/ {
    limit_except GET { deny all; }
    proxy_pass http://api:8080;
    proxy_set_header X-API-Key "${API_KEY}";
    proxy_set_header Host $host;
  }
  location /shared/ { alias /srv/shared/; }
  location = /nginx.conf.template { return 404; }
}
