# Salin ke .env lalu isi kata sandi. File .env tidak boleh di-commit.
# Basis data PostgreSQL
DB_NAME=mutu
DB_USER=mutu
DB_PASSWORD=ganti-dengan-kata-sandi-kuat
# Dasbor + API (semua antarmuka)
WEB_PORT=18080
# PostgreSQL, hanya 127.0.0.1
DB_PORT=18081
# Ambang kepatuhan dalam persen waktu
AMBANG_PERSEN=99
# Interval simulator dalam detik
TICK_DETIK=10
